# Application
APP_NAME=TripGraph AI
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=

# LLM providers (tried in this order, automatic fallback)
LLM_PROVIDERS=openai,anthropic,groq,gemini
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_BACKUP_MODELS=qwen/qwen3.8-27b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Tools
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
TOOL_TIMEOUT_SECONDS=12
TOOL_HEDGE_SECONDS=1.5

# Traffic protection
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_HOUR=60
MAX_CONCURRENT_RUNS=6

# Persistence (optional, Postgres URL for durable conversation state)
DATABASE_URL=

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agenticcore

# Other keys
PINECONE_API_KEY=
HF_API_TOKEN=
HF_API_READ_TOKEN=
HF_API_WRITE_TOKEN=
ALPHA_VANTAGE_API_KEY=
GOOGLE_API_KEY=
